; Placement notes: vocabulary at the lowest common ancestor of its users.
(shape Wide (sketch "Used in two top-level blocks: its home is the top level."))
(shape Deep (sketch "Carried by Note, declared at the top: Deep must stay where Note can see it."))
(shape Note (carries Deep))
(shape Base (sketch "Refined by Leaf, which only Shell.View uses."))
(shape Leaf (refines Base))
(shape Unused)
(behavior Idle)
(block Shell
  (shape Selection (sketch "Over-exposed: only Shell.View uses it."))
  (behavior Durable)
  (level
    (block Shell.View
      (takes Selection :as sel)
      (takes Leaf)
      (block Shell.Store (implements Durable))))
  (level (block Shell.Log (takes Wide :as w))))
(block Other
  (gives Wide :as w)
  (gives Note :as n))
