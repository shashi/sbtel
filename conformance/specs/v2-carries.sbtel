; v0.2: (carries …) is has-a between message types. A subtype carries what its supertype carries;
; recursion and cycles are allowed; accepts ignores it.
(shape Selection (sketch "Selected ids."))
(shape Camera)
(shape Source)
(shape Snapshot (carries Selection Camera Source)
  (~ What undo restores. ~))
(shape Named (refines Snapshot))
(shape History (carries Named))
(shape Turn (carries Turn Text))
(shape Text)
(shape Ping (carries Pong))
(shape Pong (carries Ping))
(behavior Saves (gives History :as h))
(block Undo
  (implements Saves)
  (takes History :as keep)
  (takes Snapshot :as snap))
(block Talk (gives Turn))
(block Net (takes Ping :as p) (gives Pong :as q))
(block Pane (takes Camera :as cam))
