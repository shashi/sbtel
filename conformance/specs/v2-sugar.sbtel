; (~ … ~) is (sketch "…"): nothing inside is special, the first closer of the same length ends it.
(shape M (~ quotes "x", a semicolon; # hash, \ backslash, (unbalanced, ~5 ms, ~/.sbtel/ ~))
(shape N (~~ a literal ~) inside ~~))
(shape O (~~~ even ~~) inside ~~~))
(shape P (~ ~))
(shape Q (~ unicode: λ → ✓ 日本 ~))
(shape R (~
    First paragraph,
    two lines.

    Second   paragraph.
  ~))
(shape S (sketch "A string sketch: still one
  line, and

  no paragraphs."))
(block A
  (takes M :as p (~ a port's own sketch ~))
  (adjacent (~ group ~) (block B) (block C))
  (level (block D)))
