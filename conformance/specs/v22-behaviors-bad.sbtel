; v0.2.2: what a behavior may not contain, cycles, scope and arguments of implements, keywords.
(message M)
(block A
  (behavior Hidden (sketch "Declared in A."))
  (block A.In (implements Hidden)))
(behavior Leaky (implements Hidden))
(behavior P (implements Q))
(behavior Q (implements R))
(behavior R (implements P))
(behavior Self (implements Self))
(behavior Ghostly (implements Ghost))
(behavior (Box T) (port b in T))
(behavior TooMany (implements (Box M M)))
(behavior BadArg (implements (Box Nope)))
(behavior NoParams (implements (Self M)))
(behavior Nest :type "trait" :kind "x"
  (block Inner)
  (level (block L))
  (adjacent (block X) (block Y))
  (message Mm)
  (behavior Bb)
  (implements (Box))
  (sketch "Holds what it may not."))
(behavior Late (sketch "x") :type "late")
(message Typed :type "struct" :fill "red")
(message Bare :type)
(block C (implements Leaky) (implements P) (implements (Box M)))
