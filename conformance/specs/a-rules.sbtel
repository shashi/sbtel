; Workstream A: one block pair per binding rule (docs/DESIGN.md §2.5), duplicates, and a block
; that sits in no level. Read with a-rules.bindings.txt.
(shape Ping (sketch "A liveness probe."))
(shape Pong (refines Ping))
(shape Wire)
(shape Ping2 (refines Wire))
(behavior (Relay T)
  (takes T :as take)
  (gives Wire :as give)
  (sketch "Passes values through."))
(block Top
  :type "System" :owner "team-a"
  (sketch "Holds everything.")
  (behavior Durable (takes Ping :as keep))
  (level
    (adjacent
      (block Ui (gives Ping)
        (level (block Ui.Button) (block Ui.Menu))
        (level (block Ui.Theme)))
      (block Cli (implements Relay)))
    (block Admin))
  (level
    (block Core
      (implements Durable)
      (shape Job (refines Ping))
      (takes Job :as jobs)
      (level (block Core.Queue (gives Job :as next)))
      (shape Stray (block Orphan))))
  (level
    (block Dup (sketch "first"))
    (block Dup (sketch "second"))))
(block Tools (sketch "Second top-level block, in the file's one implicit level."))
