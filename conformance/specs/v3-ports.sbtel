; v0.3: (port :in|:out Type [:as name] [sketch]). Default names, :as, the removed 0.2 form, clashes.
(message NoteSaved (~ A note reached the disk. ~))
(message Item)
(message URL)
(message shell.Intent)
(message List<Item>)
(message Élan)
(behavior Feed (port :out Item (~ The next item. ~)))
(behavior Other (port :out Item))
(behavior Both (implements Feed) (implements Other))
(behavior Echo (implements Feed) (port :in Item))
(behavior (Store T) (port :in T) (port :out T :as get))
(block Notes
  (level
    (block Notes.Editor
      (port :in NoteSaved (~ Refresh after a save. ~))
      (port :out Item)
      (port :in Item :as backlog)
      (port :in URL)
      (port :in shell.Intent)
      (port :in List<Item>)
      (port :in Élan)
      (port :in Item :as item2 (sketch "Named explicitly."))))
  (level
    (block Notes.Store (implements (Store Item)) (port :out NoteSaved :as noteSaved) (port :in Item :as feed))
    (block Notes.Legacy
      (port chord in Item)
      (port item out Item (~ Same name as the default. ~))
      (port saved in NoteSaved))))
(block Clash
  (port :in Item)
  (port :out Item)
  (implements Feed))
(block Twice (implements Feed) (implements Other))
(block ViaBoth (implements Both))
(block Bad
  (port in Item)
  (port :sideways Item)
  (port :in Item extra)
  (port :in Item :as x (sketch "a") (sketch "b")))
