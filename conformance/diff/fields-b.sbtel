; Every Fields key (level names and sketches, port and group sketches too), plus renamed and moved behaviors and message types.
(block Kit
  (message Data (sketch "Bytes."))
  (message Text (sketch "Characters."))
  (message Num (sketch "A number."))
  (message Any (refines Data) (sketch "Text or a number."))
  (message Event (sketch "Something happened."))
  (message Click (refines Data) (sketch "A pointer press."))
  (message Hint (sketch "A tip for the user."))
  (behavior Logging (port :out Text :as log) (sketch "Writes log lines."))
  (behavior (Box T K) (port :in T :as item) (sketch "Holds one value."))
  (level
    (block Panel
      :type "Card"
      (implements Logging)
      (implements Box)
      (port :in Data (~ Raw bytes, never parsed here. ~))
      (port :out Num :as size)
      (port :in Text :as label)
      (port :in Text :as mode2)
      (sketch "Shows one thing at a time, with a header.")
      (level :name "Frame" (~ Panel draws it; content never does. ~)
        (adjacent (~ Share one grid. ~)
          (block Header (sketch "Title row."))
          (block Body (sketch "Content area."))
          (block Footer (sketch "Status row.")))))
    (block Sidebar
      (behavior Focusable (port :in Event :as focus) (sketch "Takes keyboard focus."))
      (sketch "Lists things."))))
