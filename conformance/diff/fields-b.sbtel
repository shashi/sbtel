; Every Fields key (level names and sketches, port and group sketches too), plus renamed and moved behaviors and message types.
(block Kit
  (shape Data (sketch "Bytes."))
  (shape Text (sketch "Characters."))
  (shape Num (sketch "A number."))
  (shape Any (refines Data) (sketch "Text or a number."))
  (shape Event (sketch "Something happened."))
  (shape Click (refines Data) (sketch "A pointer press."))
  (shape Hint (sketch "A tip for the user."))
  (behavior Logging (gives Text :as log) (sketch "Writes log lines."))
  (behavior (Box T K) (takes T :as item) (sketch "Holds one value."))
  (level
    (block Panel
      :type "Card"
      (implements Logging)
      (implements Box)
      (takes Data (~ Raw bytes, never parsed here. ~))
      (gives Num :as size)
      (takes Text :as label)
      (takes Text :as mode2)
      (sketch "Shows one thing at a time, with a header.")
      (level :name "Frame" (~ Panel draws it; content never does. ~)
        (adjacent (~ Share one grid. ~)
          (block Header (sketch "Title row."))
          (block Body (sketch "Content area."))
          (block Footer (sketch "Status row.")))))
    (block Sidebar
      (behavior Focusable (takes Event :as focus) (sketch "Takes keyboard focus."))
      (sketch "Lists things."))))
