(block Pipeline
  (shape Text (sketch "Raw input."))
  (shape Ast (sketch "A syntax tree."))
  (shape Ir (sketch "Checked program."))
  (level
    (adjacent
      (block Parser
        (takes Text :as src)
        (gives Ast :as tree)
        (sketch "Parses the source."))
      (block Checker
        (takes Ast :as tree)
        (gives Ir)
        (sketch "Checks the types of every expression.")))
    (block Backend
      (takes Ir)
      (sketch "Emits machine code."))))
