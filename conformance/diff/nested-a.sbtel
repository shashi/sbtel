; A parent moves to another block, and one of its children moves to another level inside it.
(block Root
  (level
    (block Left
      (sketch "Holds the editor for now.")
      (level
        (block Editor
          (sketch "Edits documents.")
          (level
            (block Toolbar (sketch "Buttons."))
            (block Canvas (sketch "Where you type.")))
          (level
            (block Undo (sketch "History stack."))))))
    (block Right (sketch "Will hold the editor."))))
