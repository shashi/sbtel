; Every Fields key (level names and sketches, port and group sketches too), plus renamed and moved behaviors and message types.
(block Kit
  (shape Data (sketch "Bytes."))
  (shape Text (sketch "Characters."))
  (shape Num (sketch "A number."))
  (shape Any (sketch "Text or a number."))
  (shape Event (sketch "Something happened."))
  (shape Click (refines Event) (sketch "A pointer press."))
  (behavior Loggable (gives Text :as log) (sketch "Writes log lines."))
  (behavior (Box T) (takes T :as item) (sketch "Holds one value."))
  (level
    (block Panel
      :type "View"
      (implements Loggable)
      (takes Data)
      (takes Num :as size)
      (takes Text :as mode (~ Read once. ~))
      (sketch "Shows one thing at a time.")
      (behavior Focusable (takes Event :as focus) (sketch "Takes keyboard focus."))
      (level :name "Chrome"
        (adjacent (~ Share a grid. ~)
          (block Header (sketch "Title row."))
          (block Body (sketch "Content area.")))
        (block Footer (sketch "Status row."))))
    (block Sidebar
      (implements Loggable)
      (shape Hint (sketch "A tip for the user."))
      (sketch "Lists things."))))
