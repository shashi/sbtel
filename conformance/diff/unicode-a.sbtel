; Unicode names: CJK, accents, emoji (astral), and a rename of each kind.
(block Système
  (shape Café (sketch "Une tasse."))
  (shape 消息 (sketch "一条消息。"))
  (behavior Ünïcode (takes 消息 :as x) (sketch "Parle toutes les langues."))
  (level
    (block 服务器
      (implements Ünïcode)
      (takes 消息 :as 入口)
      (sketch "处理所有请求。"))
    (block Ñandú
      (gives Café)
      (sketch "Corre rápido por la pampa."))
    (block 🚀Launch (sketch "Ships the build to orbit."))))
