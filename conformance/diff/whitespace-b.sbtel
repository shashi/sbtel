(block Svc
    :type "Service"      ; same type
    (message Ping
        (sketch "Are   you
                 there?"))
    (port :in Ping)
    (sketch "Answers pings.")
    (level
        (block Clock (sketch "Ticks once a second."))   ; a clock
        (block Log
            (sketch "Appends lines."))))
