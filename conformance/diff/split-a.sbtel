(block Pipeline
  (message Text (sketch "Raw input."))
  (message Ast (sketch "A syntax tree."))
  (message Ir (sketch "Checked program."))
  (level
    (block Frontend
      (port :in Text :as src)
      (port :out Ast :as tree)
      (port :out Ir)
      (sketch "Parses the source and checks the types of every expression."))
    (block Backend
      (port :in Ir)
      (sketch "Emits machine code."))))
