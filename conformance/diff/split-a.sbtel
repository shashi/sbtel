(block Pipeline
  (shape Text (sketch "Raw input."))
  (shape Ast (sketch "A syntax tree."))
  (shape Ir (sketch "Checked program."))
  (level
    (block Frontend
      (takes Text :as src)
      (gives Ast :as tree)
      (gives Ir)
      (sketch "Parses the source and checks the types of every expression."))
    (block Backend
      (takes Ir)
      (sketch "Emits machine code."))))
