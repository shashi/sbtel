; Ports keep their kinds, but refines changes what they accept.
(block Net
  (shape Msg (sketch "Any message."))
  (shape Ping (sketch "A liveness probe."))
  (shape Data (refines Wire) (sketch "A payload."))
  (shape Wire (sketch "What travels on the wire."))
  (shape Ack (sketch "An acknowledgement."))
  (level
    (block Sender
      (gives Ping :as probe)
      (gives Ack)
      (gives Data)
      (sketch "Sends things."))
    (block Receiver
      (takes Wire)
      (takes Msg :as any)
      (sketch "Receives things."))))
