; Ports keep their kinds, but refines changes what they accept.
(block Net
  (message Msg (sketch "Any message."))
  (message Data (refines Wire) (sketch "A payload."))
  (message Wire (sketch "What travels on the wire."))
  (message Ping (refines Wire) (sketch "A liveness probe."))
  (message Ack (refines Msg) (sketch "An acknowledgement."))
  (level
    (block Sender
      (port :out Ping :as probe)
      (port :out Ack)
      (port :out Data)
      (sketch "Sends things."))
    (block Receiver
      (port :in Wire)
      (port :in Msg :as any)
      (sketch "Receives things."))))
