; Ports keep their kinds, but refines changes what they accept.
(block Net
  (shape Msg (sketch "Any message."))
  (shape Data (refines Wire) (sketch "A payload."))
  (shape Wire (sketch "What travels on the wire."))
  (shape Ping (refines Wire) (sketch "A liveness probe."))
  (shape Ack (refines Msg) (sketch "An acknowledgement."))
  (level
    (block Sender
      (gives Ping :as probe)
      (gives Ack)
      (gives Data)
      (sketch "Sends things."))
    (block Receiver
      (takes Wire)
      (takes Msg :as any)
      (sketch "Receives things."))))
