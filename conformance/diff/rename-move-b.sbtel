(block Sys
  (shape Job (sketch "A unit of work."))
  (level
    (block Api
      (sketch "Public HTTP surface.")
      (level
        (block Handlers (sketch "One handler per route."))))
    (block Worker
      (sketch "Runs jobs in the background.")
      (level
        (block Pool (sketch "Fixed set of threads.")))
      (level
        (block Throttle
          (takes Job)
          (sketch "Token bucket per worker, refilled every second."))))))
