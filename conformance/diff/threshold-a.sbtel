; Above: Cache -> Store keeps enough to pair (renamed). Below: Mailer -> Notifier keeps too little (removed + added).
(block Sys
  (shape Key (sketch "A lookup key."))
  (shape Mail (sketch "An outgoing email."))
  (level
    (block Cache
      :type "Store"
      (takes Key :as get)
      (sketch "Keeps the latest value per key in memory."))
    (block Mailer
      (takes Mail :as send)
      (sketch "Sends email through the relay."))))
