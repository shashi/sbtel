(shape Event (~ Something the user did. ~))
(shape Click (refines Event) (~ A mouse button pressed and released. ~))
(shape DoubleClick (refines Click) (~ Two clicks close together. ~))
(shape Key (refines Event) (~ A key pressed. ~))
(level :name "Listeners"
  (block Log (takes Event :as any) (~ Records every event. ~))
  (block Menu (takes Click :as open) (~ Opens on any click. ~))
  (block Zoom (takes DoubleClick :as reset) (~ Resets on a double click. ~))
  (block Shortcuts (takes Key) (~ Runs commands from keys. ~)))
(level :name "Sources"
  (block Mouse (gives Click) (gives DoubleClick :as dbl))
  (block Keyboard (gives Key)))
