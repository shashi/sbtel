(message Event (~ Something the user did. ~))
(message Click (refines Event) (~ A mouse button pressed and released. ~))
(message DoubleClick (refines Click) (~ Two clicks close together. ~))
(message Key (refines Event) (~ A key pressed. ~))
(level :name "Listeners"
  (block Log (port :in Event :as any) (~ Records every event. ~))
  (block Menu (port :in Click :as open) (~ Opens on any click. ~))
  (block Zoom (port :in DoubleClick :as reset) (~ Resets on a double click. ~))
  (block Shortcuts (port :in Key) (~ Runs commands from keys. ~)))
(level :name "Sources"
  (block Mouse (port :out Click) (port :out DoubleClick :as dbl))
  (block Keyboard (port :out Key)))
