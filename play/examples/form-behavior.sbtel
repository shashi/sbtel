(shape Frame (~ A rendered view-model. ~))
(shape Intent (~ A command id and its arguments. ~))
(behavior Surface :type "interface"
  (takes Frame)
  (gives Intent)
  (~ Draws frames and reports what the user asked for. ~))
(level :name "Surfaces"
  (block Sidebar (implements Surface) (~ Recent notes. ~))
  (block Canvas (implements Surface) (~ The open note. ~)))
(level :name "Services"
  (block Router (takes Intent) (~ Maps intents to handlers. ~)))
