(shape Note :type "struct" (~ A title and a body. ~))
(shape Edit (carries Note) (~ A change to one note. ~))
(shape RemoteEdit (refines Edit) (~ An edit made on another device. ~))
(level
  (block Editor (gives Edit) (takes RemoteEdit))
  (block Sync (gives RemoteEdit)))
(level
  (block Store (takes Edit)))
