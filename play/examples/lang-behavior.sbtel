(shape Note (~ A title and a body. ~))
(behavior Repo :type "interface"
  (takes Note :as save)
  (gives Note :as load)
  (~ Keeps notes and gives them back. ~))
(level
  (block DiskStore (implements Repo) (~ Notes as files. ~))
  (block MemoryStore (implements Repo) (~ Notes in memory, for tests. ~)))
