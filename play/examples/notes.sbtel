; A notes app: write notes, see them rendered, keep them on disk, sync them.
(block Notes :type "app"
  (~ Write notes, see them rendered, keep them on disk. ~)
  (shape Edit (~ A change to one note's text. ~))
  (shape Changed (~ A stored note changed, from either side. ~) (carries Edit))
  (level :name "The app"
    (block Shell :type "module" (~ Wires the parts to each other. ~)))
  (level :name "Notes as text"
    (adjacent (~ The preview scrolls with the editor. ~)
      (block Editor :type "module" (gives Edit) (~ The text area. ~))
      (block Preview :type "module" (takes Changed) (~ Renders the note beside the editor. ~)))
    (block Sync :type "module" (takes Changed) (gives Edit :as remote) (~ Exchanges edits with the cloud copy. ~)))
  (level :name "Stored notes"
    (~ Knows nothing of editing. ~)
    (block Store :type "module" (takes Edit) (gives Changed) (~ Keeps notes on disk. ~))
    (block Markdown :type "module" (~ Turns text into a document tree. ~))))
