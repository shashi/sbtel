(block Notes
  (shape Note :type "struct" (~ A title and a body. ~))
  (shape Edit (carries Note) (~ A change to one note. ~))
  (shape RemoteEdit (refines Edit) (~ An edit made on another device. ~))
  (shape NoteSaved (carries Note) (~ A note reached the disk. ~))
  (level :name "Notes as text"
    (block Editor (gives Edit) (takes RemoteEdit) (takes NoteSaved) (~ The text area. ~))
    (block Sync (gives RemoteEdit) (takes NoteSaved) (~ Exchanges edits with the cloud copy. ~)))
  (level :name "Stored notes"
    (block Store (takes Edit) (gives NoteSaved) (~ Keeps notes on disk. ~))))
