(shape Edit (~ A change to one note's text. ~))
(shape Changed (~ A stored note changed. ~))
(behavior Durable :type "interface"
  (takes Edit)
  (~ Keeps every accepted edit until it is on disk. ~))
(level :name "Editing"
  (block Editor (gives Edit) (~ The text area. ~))
  (block Preview (takes Changed) (~ Renders the note. ~)))
(level :name "Keeping"
  (block Store (gives Changed) (~ Keeps notes on disk. ~))
  (block Log (implements Durable) (~ An append-only journal. ~))
  (block Backup (implements Durable) (~ A copy on another disk. ~)))
