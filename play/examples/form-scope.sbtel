(shape Order (~ A customer's order. ~))
(level
  (block Checkout
    (shape CardToken (~ An opaque payment token; it never leaves Checkout. ~))
    (gives Order)
    (level (block Form (gives CardToken :as token) (~ Collects the card. ~)))
    (level (block Gateway (takes CardToken :as token) (~ Charges the card. ~)))))
(level
  (block Fulfilment (takes Order) (~ Packs and ships. ~)))
