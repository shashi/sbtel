(message Order (~ A customer's order. ~))
(level
  (block Checkout
    (message CardToken (~ An opaque payment token; it never leaves Checkout. ~))
    (port :out Order)
    (level (block Form (port :out CardToken :as token) (~ Collects the card. ~)))
    (level (block Gateway (port :in CardToken :as token) (~ Charges the card. ~)))))
(level
  (block Fulfilment (port :in Order) (~ Packs and ships. ~)))
