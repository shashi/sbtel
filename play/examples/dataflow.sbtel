(shape Selection (~ The selected ids. ~))
(shape Camera (~ Pan and zoom. ~))
(shape Snapshot (carries Selection Camera) (~ What undo restores. ~))
(level :name "Snapshots"
  (block History (takes Snapshot :as undo))
  (block Autosave (takes Snapshot :as save)))
(level :name "Drawing"
  (block Canvas (gives Camera :as view))
  (block Picker (gives Selection :as picked)))
