(block Notes
  (message NoteSaved (~ A note reached the disk. ~))
  (level :name "The app"
    (block Shell (~ Opens the window and wires the parts together. ~)))
  (level :name "Notes as text"
    (adjacent (~ The preview scrolls with the editor, line for line. ~)
      (block Editor (port :in NoteSaved) (~ The text area. ~))
      (block Preview (~ Renders the note beside the editor. ~)))
    (block Sync (port :in NoteSaved) (~ Exchanges edits with the cloud copy. ~))
    (block Search (~ Finds notes by their words. ~)))
  (level :name "Stored notes"
    (block Store (port :out NoteSaved) (~ Keeps notes on disk. ~))
    (block Markdown (~ Turns text into a document tree. ~))
    (block Index (~ Maps words to notes. ~))))
