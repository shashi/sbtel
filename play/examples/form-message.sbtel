(shape KeyChord (~ A normalized key combination, like Ctrl-K. ~))
(level :name "Surfaces"
  (block Palette (takes KeyChord :as chord (~ Opens the palette. ~)) (~ Fuzzy search over commands. ~)))
(level :name "Services"
  (block Keymap (gives KeyChord :as chord) (~ Turns raw key events into chords. ~)))
