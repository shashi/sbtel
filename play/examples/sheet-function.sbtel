; The Function interface: the Evaluator calls functions only through it.
; The built-in Functions and the AddIns implement it.
(shape Arguments (~ The values a call passes, like A1:A9 in =SUM(A1:A9). ~))
(shape Result (~ What the function gives back. ~))
(behavior Function :type "TypeScript interface"
  (takes Arguments)
  (gives Result)
  (~ Anything a formula can call by name: =SUM(…), =MYADDIN(…). ~))
(level :name "The app"
  (block Main :type "module" (~ Starts everything and wires the parts together. ~)))
(level :name "Add-ins"
  (block AddIns :type "module" (implements Function)
    (~ Functions other people wrote, loaded at startup. ~)))
(level :name "Formulas"
  (block Evaluator :type "module" (~ Computes a formula's value, calling functions by name. ~)))
(level :name "Built-in functions"
  (block Functions :type "module" (implements Function) (~ SUM, VLOOKUP, SORTBY and the rest. ~)))
