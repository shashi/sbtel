; Notes: who sends and takes which message, and what a message carries.
(block Notes
  (shape Note (~ A note's title and text. ~))
  (shape NoteSaved (carries Note) (~ A note reached the disk. ~))
  (level :name "App"
    (block Editor (takes NoteSaved) (gives Note))
    (block Preview (takes Note)))
  (level :name "Stored and formatted notes"
    (block Store (gives NoteSaved))
    (block Formatter)))
