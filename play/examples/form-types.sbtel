(shape Event (~ Something the user did. ~))
(shape Click (refines Event) (~ A mouse button pressed and released. ~))
(shape Key (refines Event) (~ A key pressed. ~))
(shape Selection (~ The selected ids. ~))
(shape Camera (~ Pan and zoom. ~))
(shape Snapshot (carries Selection Camera) (~ What undo restores. ~))
(level :name "Reacting"
  (block History (takes Snapshot :as undo) (takes Event :as seen))
  (block Autosave (takes Snapshot :as save))
  (block Menu (takes Click :as open))
  (block Shortcuts (takes Key)))
(level :name "Input"
  (block Mouse (gives Click) (gives Camera :as view))
  (block Keyboard (gives Key))
  (block Picker (gives Selection :as picked)))
