(message Event (~ Something the user did. ~))
(message Click (refines Event) (~ A mouse button pressed and released. ~))
(message Key (refines Event) (~ A key pressed. ~))
(message Selection (~ The selected ids. ~))
(message Camera (~ Pan and zoom. ~))
(message Snapshot (carries Selection Camera) (~ What undo restores. ~))
(level :name "Reacting"
  (block History (port :in Snapshot :as undo) (port :in Event :as seen))
  (block Autosave (port :in Snapshot :as save))
  (block Menu (port :in Click :as open))
  (block Shortcuts (port :in Key)))
(level :name "Input"
  (block Mouse (port :out Click) (port :out Camera :as view))
  (block Keyboard (port :out Key))
  (block Picker (port :out Selection :as picked)))
